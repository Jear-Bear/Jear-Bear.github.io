# Copy to .dev.vars for `npm run dev` (never commit .dev.vars).
# Use throwaway values locally; the real ones live only in GitHub secrets.
SPONSOR_MANAGEMENT_PASSWORD=local-dev-password-change-me
CRM_SESSION_KEY=local-dev-session-key-at-least-32-characters-long
PUBLIC_ORIGIN=http://localhost:8787

# Optional: lets the stats Action send daily history (32+ characters)
CRM_INGEST_KEY=local-dev-ingest-key-change-me-0123456789
